    "sr.nouns.locative.basic": {
      "title": { "ru": "Локатив: о ком? где?", "en": "Locative: about what? where?" },
      "columns": {
        "pattern_ru": { "ru": "Тип", "en": "Pattern" },
        "pattern_en": { "ru": "Тип", "en": "Pattern" },
        "one": { "ru": "Один", "en": "One" },
        "many": { "ru": "Много", "en": "Many" }
      },
      "rows": [
        {
          "pattern_ru": "Он / Оно",
          "pattern_en": "Masculine / Neuter",
          "one": "-у: град / grad → о граду / o gradu; дрво / drvo → о дрву / o drvu; мост / most → на мосту / na mostu",
          "many": "-има, -овима: дрва / drva → о дрвима / o drvima; мостови / mostovi → о мостовима / o mostovima; комшије / komšije → о комшијама / o komšijama; хотели / hoteli → о хотелима / o hotelima; села / sela → о селима / o selima"
        },
        {
          "pattern_ru": "Она",
          "pattern_en": "Feminine",
          "one": "-и: река / reka → о реци / o reci; улица / ulica → у улици / u ulici; зграда / zgrada → у згради / u zgradi",
          "many": "-ама: реке / reke → о рекама / o rekama; улице / ulice → о улицама / o ulicama; торбе / torbe → о торбама / o torbama; оловке / olovke → о оловкама / o olovkama"
        }
      ],
      "notes": [
        {
          "ru": "Вопросы: о ком? о чём? / o kome? o čemu?; где? / gde?",
          "en": "Questions: about whom? about what? / o kome? o čemu?; where? / gde?"
        },
        {
          "ru": "Предлог о / o нужен для темы разговора, чтения, письма, знания или изучения: о мосту / o mostu (ед. ч.), о улицама / o ulicama (мн. ч.).",
          "en": "The preposition o marks the topic of speaking, reading, writing, knowing, or studying: o mostu (singular), o ulicama (plural)."
        },
        {
          "ru": "Предлог у / u чаще значит внутри физического объёма или в стране/регионе: у Србији / u Srbiji, у кући / u kući, у биоскопу / u bioskopu.",
          "en": "The preposition u usually means inside a physical volume or in a country/region: u Srbiji, u kući, u bioskopu."
        },
        {
          "ru": "Предлог на / na часто используется для открытых пространств, плоских поверхностей и конструкций: на мосту / na mostu, на реци / na reci, на столу / na stolu.",
          "en": "The preposition na is common for open spaces, flat surfaces, and structures: na mostu, na reci, na stolu."
        },
        {
          "ru": "В единственном числе окончание часто -у для Он/Оно и -и для Она. Перед окончанием может меняться согласная или основа: река / reka → реци / reci; орах / orah → орасима / orasima; књига / knjiga → књизи / knjizi; посао / posao → послу / poslu.",
          "en": "In singular, the ending is often -u for masculine/neuter and -i for feminine. A consonant or stem can change before the ending: reka → reci; orah → orasima; knjiga → knjizi; posao → poslu."
        },
        {
          "ru": "О смене согласных в сложных формах множественного числа см. соседнюю вкладку.",
          "en": "For consonant changes in harder plural forms, see the neighboring tab."
        }
      ]
    },
